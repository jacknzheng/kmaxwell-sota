val_data: data/fineweb10B/fineweb_val_*.bin
val_tokens: 10485760
resume_checkpoint: /root/blog_six/work/lrhalf/restart/shared_2009
model:
  vocab_size: 50304
  num_layers: 12
  model_dim: 768
wandb_offline: true
seed_offset: 1337
reseed_before_initialization: true
require_world_size: 8
train_steps: 6475
initialization:
  zero_projection: true
  weight_scales: {}
optimizer_groups:
- pattern: ^embed\.weight$
  optimizer: adamw
  hyperparams:
    lr: 0.7
    weight_decay: 0.001
  lr_schedule:
    kind: piecewise_constant
    boundaries:
    - 2009
    factors:
    - 1.0
    - 0.5
- pattern: ^proj\.weight$
  optimizer: adamw
  hyperparams:
    lr: 0.004
    weight_decay: 0.001
  lr_schedule:
    kind: piecewise_constant
    boundaries:
    - 2009
    factors:
    - 1.0
    - 0.5
- pattern: ^blocks\..*\.weight$
  optimizer: muon
  hyperparams:
    lr: 0.025
    weight_decay: 0.05
    momentum:
      kind: ema
      decay: 0.95
      nesterov_mix: 0.95
  lr_schedule:
    kind: piecewise_constant
    boundaries:
    - 2009
    factors:
    - 1.0
    - 0.5
- pattern: ^(?!embed\.weight$|proj\.weight$|blocks\..*\.weight$).*
  optimizer: adamw
  hyperparams:
    lr: 0.015
    weight_decay: 0.001
  lr_schedule:
    kind: piecewise_constant
    boundaries:
    - 2009
    factors:
    - 1.0
    - 0.5
setup:
- name: open_rank_zero_log
- name: load_validation_tokens
- name: build_compiled_gpt
- name: seed_then_initialize_parameters
- name: assemble_grouped_optimizer
- name: restore_checkpoint
- name: open_training_batches
- name: broadcast_initial_parameters
- name: validate_at_step_boundaries
pre_optimizer:
- name: schedule_optimizer_groups
post_optimizer:
- name: print_training_progress
- name: validate_at_step_boundaries
  hyperparams:
    every: 3800
    final_tenth_every: 3800
- name: checkpoint_state
teardown:
- name: mark_log_finished
checkpoint_every: 999999
