wandb_offline: true
seed_offset: 1337
reseed_before_initialization: true
require_world_size: 8
train_steps: 6475
initialization:
  zero_projection: true
  weight_scales: {}
optimizer_groups:
- pattern: ^embed\.weight$
  optimizer: adamw
  hyperparams:
    lr: 0.7
    weight_decay: 0.001
  lr_schedule:
    kind: piecewise_constant
    boundaries: []
    factors:
    - 1.0
- pattern: ^proj\.weight$
  optimizer: adamw
  hyperparams:
    lr: 0.004
    weight_decay: 0.001
  lr_schedule:
    kind: piecewise_constant
    boundaries: []
    factors:
    - 1.0
- pattern: ^blocks\..*\.weight$
  optimizer: muon
  hyperparams:
    lr: 0.025
    weight_decay: 0.05
    momentum:
      kind: tied_step_nesterov
      beta_after: 0.9750961447125188
      beta_before: 0.95
      start_step: 2009
  lr_schedule:
    kind: piecewise_constant
    boundaries: []
    factors:
    - 1.0
- pattern: ^(?!embed\.weight$|proj\.weight$|blocks\..*\.weight$).*
  optimizer: adamw
  hyperparams:
    lr: 0.015
    weight_decay: 0.001
  lr_schedule:
    kind: piecewise_constant
    boundaries: []
    factors:
    - 1.0
setup:
- name: open_rank_zero_log
- name: load_validation_tokens
- name: build_compiled_gpt
- name: seed_then_initialize_parameters
- name: assemble_grouped_optimizer
- name: restore_checkpoint
- name: open_training_batches
- name: broadcast_initial_parameters
- name: validate_at_step_boundaries
pre_optimizer:
- name: schedule_optimizer_groups
post_optimizer:
- name: print_training_progress
- name: validate_at_step_boundaries
  hyperparams:
    every: 25
    final_tenth_every: 25
    dense_window:
    - 2196
    - 2196
    dense_every: 1
- name: checkpoint_state
teardown:
- name: mark_log_finished
