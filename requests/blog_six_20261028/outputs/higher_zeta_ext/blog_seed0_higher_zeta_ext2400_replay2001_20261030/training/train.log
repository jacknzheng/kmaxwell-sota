optimizer_groups:
- pattern: ^embed\.weight$
  optimizer: adamw
  hyperparams:
    lr: 0.7
    weight_decay: 0.001
  lr_schedule:
    kind: piecewise_constant
    boundaries: []
    factors:
    - 1.0
- pattern: ^proj\.weight$
  optimizer: adamw
  hyperparams:
    lr: 0.004
    weight_decay: 0.001
  lr_schedule:
    kind: piecewise_constant
    boundaries: []
    factors:
    - 1.0
- pattern: ^blocks\..*\.weight$
  optimizer: muon
  hyperparams:
    lr: 0.025
    weight_decay: 0.05
    momentum:
      kind: tied_step_nesterov
      beta_after: 0.9750961447125188
      beta_before: 0.95
      start_step: 2009
  lr_schedule:
    kind: piecewise_constant
    boundaries: []
    factors:
    - 1.0
- pattern: ^(?!embed\.weight$|proj\.weight$|blocks\..*\.weight$).*
  optimizer: adamw
  hyperparams:
    lr: 0.015
    weight_decay: 0.001
  lr_schedule:
    kind: piecewise_constant
    boundaries: []
    factors:
    - 1.0
