+    def _maybe_dump_samples(self, trajs, micro, student_lp, teacher_lp) -> None:
+        """Dump up to 3 full teacher/student pairs with per-token gap to
+        SDPO_SAMPLES_PATH (REQ-002 §4). A mean gap can look fine while the hint does
+        nothing; the per-token trace is how a human tells 'real hint' from 'cosmetic'."""
+        import json
+        import os as _os
+
+        path = _os.environ.get("SDPO_SAMPLES_PATH")
+        if not path or self._samples_dumped >= 3:
+            return
+        if dist.is_available() and dist.is_initialized() and dist.get_rank() != 0:
+            return
+        try:
+            with torch.no_grad():
+                gaps = (teacher_lp - student_lp).detach()
+            with open(path, "a", encoding="utf-8") as f:
+                for i, t in enumerate(trajs):
+                    if self._samples_dumped >= 3:
+                        break
+                    mask = micro.response_mask[i].bool()
+                    row_gap = gaps[i][mask].float().cpu().tolist()
+                    rec = {
+                        "step": int(self.state.step),
+                        "task_id": t.task_id,
+                        "hint_free": t.hint_free,
