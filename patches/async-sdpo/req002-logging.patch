+                logger.warning("eval generation failed for task %s (%s)",
+                               getattr(task, "task_id", "?"), type(exc).__name__)
+                return task, None, type(exc).__name__
+
+    triples = await asyncio.gather(*(one(task) for task in tasks))
+    ok = [(task, result) for task, result, err in triples if err is None]
