+def _dump_eval_rows(dump_path, rows) -> None:
+    """Append per-task eval rows as JSONL (REQ-002 §4). Aggregate means hide a
+    collapsed domain; per-task rows do not. Never raises."""
+    if dump_path is None:
+        return
+    try:
+        import json as _json
+
+        p = Path(dump_path)
+        p.parent.mkdir(parents=True, exist_ok=True)
+        with p.open("a", encoding="utf-8") as f:
